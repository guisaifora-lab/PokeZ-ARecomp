                                 -DGAMELIB_SHARED='"$(GAMELIB_SHARED)"'
 
+$(B)/rt/platform/$(PLATFORM).o: Makefile
+$(B)/rt/platform/$(PLATFORM).o: RTFLAGS += $(GENCPU)
